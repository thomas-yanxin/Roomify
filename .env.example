# Copy to .env and fill in. Roomify reads these from the process environment;
# it never ships default credentials or endpoints in code.
ROOMIFY_VLM_API_KEY=
ROOMIFY_VLM_BASE_URL=            # e.g. https://api.openai.com/v1 (any OpenAI-compatible endpoint)
ROOMIFY_VLM_MODEL=               # e.g. qwen3.8-max / gpt-4o — must support vision

# Optional: directory containing real floor-plan images for integration tests
ROOMIFY_EXAMPLES_DIR=
